+Put
+
+    A4=2296826751679/30073680,
+    m3=336572872/208845, t3=225985217/1253070,
+    m2=5834/39, t2=137/6,
+    l3=m3+4t3=292337810/125307,
+    b23=3(m2*t3+m3*t2)=222621900791/1163565,
+    b33=6m3*t3=76060493515233224/43616234025.              (R2)
