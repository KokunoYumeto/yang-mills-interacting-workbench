+        st = []
+        for e, (n, i) in enumerate(edges):
+            t = list(n)
+            t[i] += 1
+            if n == v or tuple(t) == v:
+                st.append(e)
+        stars.append(st)
+    return vertices, edges, faces, boundaries, adjacent, incident, stars
