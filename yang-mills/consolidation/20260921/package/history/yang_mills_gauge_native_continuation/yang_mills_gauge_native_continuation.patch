+\[
+ \boxed{\begin{aligned}
+ \|[W]\|_{\mathcal K/(D+\kappa)V_1,dual}^2
+     &=M(\kappa)-|c_Y|^2/a_Y,\\
+ R&=R_{\rm can}+(\alpha_Y-1)(D+\kappa)Y,\\
