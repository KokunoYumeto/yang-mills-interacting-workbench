+def quatmul(A, B):
+    def m(i,j): return pm(A[i], B[j])
+    return [pa(pa(m(0,0), ps(-1,m(1,1))),pa(ps(-1,m(2,2)),ps(-1,m(3,3)))),
+            pa(pa(m(0,1),m(1,0)),pa(m(2,3),ps(-1,m(3,2)))),
+            pa(pa(m(0,2),m(2,0)),pa(m(3,1),ps(-1,m(1,3)))),
+            pa(pa(m(0,3),m(3,0)),pa(m(1,2),ps(-1,m(2,1))))]
