+
+def integrate(A, groups=(0,1,2)):
+    out = {}
+    for e,a in A.items():
+        f = list(e); value=a
+        for g in groups:
+            value *= sphere_moment(e[4*g:4*g+4])
+            for i in range(4*g,4*g+4): f[i]=0
+        if value: out[tuple(f)] = out.get(tuple(f),F(0))+value
+    return {e:a for e,a in out.items() if a}
