+
+def sphere_moment(exp):
+    if any(e % 2 for e in exp): return F(0)
+    k = [e//2 for e in exp]
+    numerator = 1
+    for a in k:
+        for b in range(1,2*a,2): numerator *= b
+    denominator = 1
+    for b in range(sum(k)): denominator *= 4+2*b
+    return F(numerator,denominator)
