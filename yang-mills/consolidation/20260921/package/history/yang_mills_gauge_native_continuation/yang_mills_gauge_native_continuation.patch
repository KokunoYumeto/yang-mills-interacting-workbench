+def pm(A, B):
+    C = {}
+    for e, a in A.items():
+        for f, b in B.items():
+            g = tuple(x+y for x, y in zip(e, f))
+            C[g] = C.get(g, F(0)) + a*b
+    return {g:c for g,c in C.items() if c}
