+    CHECKS.append(name)
+
+
+def reject(name: str, proposed: bool) -> None:
+    require(name not in CONTROLS, 'duplicate-control:' + name)
+    require(not bool(proposed), 'false-formula-accepted:' + name)
+    CONTROLS.append(name)
