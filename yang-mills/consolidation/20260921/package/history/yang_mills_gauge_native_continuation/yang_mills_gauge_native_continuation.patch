+def zero(n,m):return M(n,m,(Q(0),)*(n*m))
+def det(A):
+    require(A.n==A.m,'det-square')
+    out=Q(0)
+    for p in itertools.permutations(range(A.n)):
+        x=Q((-1)**sum(p[i]>p[j] for i in range(A.n) for j in range(i+1,A.n)))
+        for i,j in enumerate(p):x*=A.at(i,j)
+        out+=x
+    return out
