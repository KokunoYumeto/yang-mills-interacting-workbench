+\[
+ \operatorname{spec}(K_L|_{\mathrm{phys}})\subset
+ \{0,3\}\cup[9/2,\infty),\qquad
+ \ker(K_L-3)=\operatorname{span}\{W_p:p\in P_L\}.          \tag{G8}
+\]
