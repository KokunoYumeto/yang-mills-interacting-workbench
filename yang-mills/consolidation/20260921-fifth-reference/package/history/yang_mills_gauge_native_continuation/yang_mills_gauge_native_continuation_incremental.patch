+\[
+ \mathcal A_{\kappa_2,\xi}-\mathcal A_{\kappa_1,\xi}
+  =(\kappa_2-\kappa_1)
+       \left[K_L-2\sum_i(X_iv_L(\xi))X_i\right].        \tag{R15}
